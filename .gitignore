# ---- secrets and runtime state (never commit) -------------------------------
# These files live in ~/.pi/eink/. They are listed here as well so that a state
# directory copied into the working tree, or a viewer started with cwd here, can
# never end up in a commit.
token
pin
masked_secrets
allow_ips
uas
ua_seen.log
bridge.json
bridges.json
pending.json
answer.json
# the session the viewer last rendered; server-written, keeps read-only pages from
# chasing "newest"
view.json
bridge.log
server.log
diag.log
actions.log

# network trust, guess counters, and what the installer recorded
trust.json
fails.json
install-meta

# service units and logs contain absolute paths and a local username
*.plist
*.service
*.log

# atomic writes and rotated logs (the code creates these next to their target)
*.tmp
*.log.[0-9]

# ---- local artifacts --------------------------------------------------------
__pycache__/
*.pyc
.DS_Store
*.swp
node_modules/

# coverage.py data
.coverage
.coverage.*
